# !rag-app/knowledge-base/.gitkeep

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test / coverage
coverage/
.nyc_output/
