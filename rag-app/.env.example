# OpenAI — required for embeddings and chat
OPENAI_API_KEY=sk-your-openai-api-key

# ChromaDB — local Docker server (default)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=kb_collection

# Express server port
PORT=3000

# Optional: Chroma Cloud (instead of local Docker)
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# Optional: Redis caching (falls back to in-memory if unset)
# REDIS_URL=redis://localhost:6379

# Optional: Cohere reranking
# COHERE_API_KEY=

# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=rag-app
